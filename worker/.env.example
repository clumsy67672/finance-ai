# Hermes Worker — OmniRoute Integration
# Copy this file to .env and adjust values for your environment.
# All settings can also be provided as environment variables.

# ---------------------------------------------------------------------------
# Finance-AI Server
# ---------------------------------------------------------------------------
SERVER_URL=http://192.168.1.50:3000
# The base URL of the finance-ai server (default: http://192.168.1.50:3000)

# ---------------------------------------------------------------------------
# OmniRoute Gateway
# ---------------------------------------------------------------------------
OMNIROUTE_URL=http://localhost:8000/v1
# Base URL for the OmniRoute Gateway API (default: http://localhost:8000/v1)

OMNIROUTE_API_KEY=
# Bearer token for OmniRoute authentication (optional — leave empty to skip auth)

OMNIROUTE_MODEL=deepseek-v4-flash
# Model identifier to use via OmniRoute (default: deepseek-v4-flash)

# ---------------------------------------------------------------------------
# Worker Behaviour
# ---------------------------------------------------------------------------
POLL_INTERVAL=60
# Seconds to wait between polling cycles in daemon mode (default: 60)

BATCH_SIZE=20
# Maximum number of pending queue items to fetch per batch (default: 20)
