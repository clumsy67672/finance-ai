generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

enum Direction {
  expense
  income
  transfer
}

enum Source {
  cash
  bank
  ewallet
  unknown
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  passwordHash String
  role         Role          @default(member)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  sessions     Session[]
  recurringTxs RecurringTx[]
  budgets     Budget[]
  goals       Goal[]
  challenges  Challenge[]
}

model Session {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Transaction {
  id           String    @id @default(uuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  occurredAt   DateTime  @default(now())
  amount       Int
  direction    Direction
  rawMessage   String    @db.VarChar(280)
  cleanNote    String    @db.VarChar(280)
  category     String    @db.VarChar(64)
  merchant     String?   @db.VarChar(128)
  source       Source    @default(unknown)
  tags         Json
  aiConfidence Float
  aiModel      String    @db.VarChar(64)
  aiVersion    String    @db.VarChar(32)
  rawQueueId   String?
  rawQueue     RawQueue? @relation(fields: [rawQueueId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, occurredAt])
  @@index([category])
}

model RawQueue {
  id        String   @id @default(uuid())
  rawText   String
  userId    String?
  createdAt DateTime @default(now())
  status    String   @default("PENDING") // PENDING | PROCESSING | PROCESSED | ERROR
  error     String?
  transactions Transaction[]
}

model InsightCache {
  id        String   @id @default(uuid())
  userId    String
  month     String // YYYY-MM
  payload   Json // { status_kesehatan, analisa_utama, rekomendasi_aksi[] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId, month])
}

model RecurringTx {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @db.VarChar(120)
  amount      Int
  direction   Direction @default(expense)
  category    String   @db.VarChar(64)
  source      Source   @default(unknown)
  note        String?  @db.VarChar(280)
  dayOfMonth  Int      @default(25) // which day it posts each month
  active      Boolean  @default(true)
  lastPosted  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, active])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   @db.VarChar(64)
  amount    Int // target spend per pay-period (monthly)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
}

model Goal {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(200)
  note      String?   @db.VarChar(500)
  amount    Int       // target amount in rupiah
  saved     Int       @default(0) // current saved amount
  deadline  DateTime?
  achieved  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Challenge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String    @db.VarChar(200)
  note       String?   @db.VarChar(500)
  amount     Int       // monthly obligation
  startDate  DateTime
  endDate    DateTime?
  active     Boolean   @default(true)
  severity   String    @default("high") // low | medium | high | critical
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
